{
  "expo": {
    "name": "Organizador Docente",
    "slug": "organizador-docente",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.organizadordocente.app"
    },
    "android": {
      "package": "com.organizadordocente.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#7c3aed",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1e1b4b"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "bits-q9",
          "project": "organizador-mobile"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9617ebf0-e58a-4c09-9cd3-864575ca1cc2"
      }
    },
    "owner": "alancito1298"
  }
}
