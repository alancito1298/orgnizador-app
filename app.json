{
  "expo": {
    "name": "Organizador Docente",
    "slug": "organizador-docente",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.organizadordocente.app"
    },
    "android": {
      "package": "com.organizadordocente.app",
      "versionCode": 22,
      "adaptiveIcon": {
        "backgroundColor": "#7c3aed",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1e1b4b"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "bits-q9",
          "project": "organizador-mobile"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.868455775736-8gvm8ad8kdj0206iifc2qka0043c5s46"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3715321688716274~1485732126",
          "iosAppId": "ca-app-pub-3715321688716274~1485732126",
          "optimizeInitialization": true,
          "optimizeAdLoading": true
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "9617ebf0-e58a-4c09-9cd3-864575ca1cc2"
      }
    },
    "owner": "alancito1298"
  }
}
